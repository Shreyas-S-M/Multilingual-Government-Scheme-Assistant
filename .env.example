# ================================================================
# Multilingual Government Scheme Assistant - Environment Configuration
# ================================================================

# Application
APP_NAME="Multilingual Government Scheme Assistant"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"

# API Server
API_HOST="127.0.0.1"
API_PORT=8000
API_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Frontend (Streamlit)
BACKEND_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Database Configuration
# Default to SQLite for zero-setup local dev/testing; set PostgreSQL for production
DATABASE_URL="sqlite:///./data/processed/scheme_assistant.db"
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/scheme_db

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_API_KEY="admin-secret-dev-key-change-in-production"

# NLP & Multilingual Models
# Multilingual embedding model for English & Kannada semantic search
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
DEVICE="cpu"
FAISS_INDEX_PATH="./data/processed/faiss_index.bin"
INDEX_METADATA_PATH="./data/processed/index_metadata.json"
SCHEMES_DATA_DIR="./data/schemes"

# RAG & LLM Configuration (Provider Independent)
# Options: "deterministic" (zero-dependency default), "gemini", "openai", "local"
LLM_PROVIDER="deterministic"
LLM_MODEL_NAME="gemini-1.5-flash"
LLM_API_KEY=""

# Feature Flags
ENABLE_HYBRID_RETRIEVAL=True
ENABLE_ADAPTIVE_QUESTIONING=True
ENABLE_NEAR_MISS_RECOMMENDATIONS=True
ENABLE_CANONICAL_LOGGING=True
